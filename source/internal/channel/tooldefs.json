      "string"
     ]
    },
    "from": {
     "description": "registered live sender Session.Name or session ID in this project; registration is required but is not caller authentication",
     "type": "string"
    },
    "to": {
     "description": "recipient Session.Name communication address or session ID",
     "type": "string"
    }
   },
   "required": [
